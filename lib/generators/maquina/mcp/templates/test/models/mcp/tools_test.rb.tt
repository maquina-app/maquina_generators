require "test_helper"
<% if options[:flag] -%>
require_relative "../../test_helpers/session_test_helper"
<% end -%>

# The tool registry (generated by maquina:mcp): every module in
# app/models/mcp/tools/ is well formed, and no tool that changes data can be
# called with a read-only token because it was left out of WRITE_TOOLS.
class McpToolsTest < ActionDispatch::IntegrationTest
  test "every tool that is not read-only is in its module's WRITE_TOOLS" do
    assert_not_empty Mcp::ToolDefinitions.modules

    Mcp::ToolDefinitions.modules.each do |mod|
      mod::DEFINITIONS.each do |definition|
        next if definition.dig(:annotations, :readOnlyHint) == true

        assert_includes mod::WRITE_TOOLS, definition[:name], "#{mod}: #{definition[:name]} changes data, add it to WRITE_TOOLS"
      end
    end
  end

  test "every write tool is declared and marked as not read-only" do
    assert_not_empty Mcp::ToolDefinitions.modules

    Mcp::ToolDefinitions.modules.each do |mod|
      mod::WRITE_TOOLS.each do |name|
        definition = mod::DEFINITIONS.find { |candidate| candidate[:name] == name }

        assert definition, "#{mod}: WRITE_TOOLS names #{name}, which has no definition"
        assert_equal false, definition.dig(:annotations, :readOnlyHint), "#{mod}: #{name} needs readOnlyHint: false"
      end
    end
  end

  test "every module declares its tools the same way" do
    names = Mcp::ToolDefinitions.modules.flat_map do |mod|
      assert mod::DEFINITIONS.frozen?, "#{mod}::DEFINITIONS must be frozen"
      assert mod::WRITE_TOOLS.frozen?, "#{mod}::WRITE_TOOLS must be frozen"
      assert_includes [true, false], mod::ADMIN_ONLY, "#{mod}::ADMIN_ONLY must be true or false"

      mod::DEFINITIONS.map do |definition|
        schema = definition[:inputSchema]
        assert definition[:description].present?, "#{definition[:name]} needs a description"
        assert_equal "https://json-schema.org/draft/2020-12/schema", schema[:$schema], definition[:name]
        assert_equal "object", schema[:type], definition[:name]
        assert_equal false, schema[:additionalProperties], definition[:name]
        assert mod.respond_to?(definition[:name]), "#{mod} has no method #{definition[:name]}"
        definition[:name]
      end
    end

    assert_equal names.uniq, names, "tool names must be unique across modules"
  end

  test "whoami reports the user, the scope and the protocol revision" do
    scope = Mcp::UserScope.new(users(:mcp_member), oauth_scopes: %w[read])

    result = Mcp::Tools.call("whoami", {}, scope: scope)

    assert_equal false, result[:isError]
    assert_equal users(:mcp_member).email_address, result.dig(:structuredContent, :email)
    assert_equal "read", result.dig(:structuredContent, :scope)
    assert_equal Mcp::PROTOCOL_VERSION, result.dig(:structuredContent, :protocol_version)
  end

  test "arguments are checked against the schema before the tool runs" do
    scope = Mcp::UserScope.new(users(:mcp_member), oauth_scopes: %w[read])

    error = assert_raises(Mcp::Tools::InvalidParams) { Mcp::Tools.call("whoami", {"verbose" => true}, scope: scope) }
    assert_includes error.message, "verbose"
  end

  test "a member does not see admin-only tools" do
    admin_only = Mcp::ToolDefinitions.modules.select { |mod| mod::ADMIN_ONLY }.flat_map { |mod| mod::DEFINITIONS }
    visible = Mcp::ToolDefinitions.for(users(:mcp_member))

    assert_empty admin_only & visible
  end

  test "a record that is not the user's is the same not found as a missing one" do
    scope = Mcp::UserScope.new(users(:mcp_member))
    other = users(:mcp_other).sessions.create!

    foreign = assert_raises(Mcp::ToolError) { scope.find(:sessions, other.id) }
    missing = assert_raises(Mcp::ToolError) { scope.find(:sessions, 0) }
    assert_equal missing.message, foreign.message
    assert_equal Mcp::ToolError::NOT_FOUND, foreign.message
  end
<% if options[:flag] -%>

  # Mcp::FLAG is :<%= options[:flag] %>. With it off for the user:

  test "with the flag off the scope reaches nothing" do
    user = users(:mcp_member)
    user.sessions.create!
    mcp_flag(false)

    scope = Mcp::UserScope.new(user)

    assert_not scope.enabled?
    assert_empty scope.records(:sessions)
  end

  test "with the flag off consent is refused" do
    sign_in_as users(:mcp_member)
    mcp_flag(false)

    get "/oauth/authorize", params: authorize_params(challenge: pkce_pair.last)

    assert_response :see_other
    assert_equal "access_denied", redirect_params["error"]
  end

  test "with the flag off the Connected apps page is not found" do
    sign_in_as users(:mcp_member)
    mcp_flag(false)

    get connected_apps_path

    assert_response :not_found
  end

  test "with the flag off server/discover still answers" do
    mcp_flag(false)

    mcp_post({method: "server/discover"})

    assert_response :success
    assert_equal [Mcp::PROTOCOL_VERSION], response.parsed_body.dig("result", "supportedVersions")
  end

  test "with the flag off whoami says so and admin-only tools are hidden" do
    token = oauth_token_for(users(:mcp_admin))
    mcp_flag(false)

    mcp_post({method: "tools/list"}, token: token)
    names = response.parsed_body.dig("result", "tools").map { |tool| tool["name"] }
    admin_only = Mcp::ToolDefinitions.modules.select { |mod| mod::ADMIN_ONLY }.flat_map { |mod| mod::DEFINITIONS.map { |d| d[:name] } }
    assert_empty admin_only & names

    mcp_post({method: "tools/call", params: {name: "whoami", arguments: {}}}, token: token)
    assert_equal({"name" => "<%= options[:flag] %>", "enabled" => false}, response.parsed_body.dig("result", "structuredContent", "flag"))
  end
<% end -%>
end
