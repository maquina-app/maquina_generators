require "test_helper"
require_relative "../test_helpers/session_test_helper"

# An MCP client connecting end to end (generated by maquina:mcp): discovery,
# consent, the token exchange, a tool call, and revocation from the Connected
# apps page. The inspector fixture's metadata is fresh, so nothing is fetched.
class McpFlowTest < ActionDispatch::IntegrationTest
  test "a client discovers, is authorized, calls whoami and loses access when revoked" do
    user = users(:mcp_member)
    client = oauth_clients(:inspector)

    mcp_post({method: "server/discover"})
    assert_response :success
    assert_equal [Mcp::PROTOCOL_VERSION], response.parsed_body.dig("result", "supportedVersions")

    mcp_post({method: "tools/list"})
    assert_response :unauthorized
    metadata_url = response.headers["WWW-Authenticate"][/resource_metadata="([^"]+)"/, 1]

    get URI(metadata_url).path
    assert_equal "http://www.example.com/mcp", response.parsed_body["resource"]
    get "/.well-known/oauth-authorization-server"
    assert_equal "/oauth/authorize", URI(response.parsed_body["authorization_endpoint"]).path

    verifier, challenge = pkce_pair
    sign_in_as user
<% unless options[:skip_views] -%>
    get "/oauth/authorize", params: authorize_params(challenge: challenge)
    assert_response :success
    assert_includes response.body, client.client_name
<% end -%>

    post "/oauth/authorize", params: authorize_params(challenge: challenge).merge(decision: "allow")
    assert_equal "xyz-state", redirect_params["state"]
    assert_equal "http://www.example.com", redirect_params["iss"]

    post "/oauth/token", params: {
      grant_type: "authorization_code",
      code: redirect_params["code"],
      redirect_uri: OauthTestHelper::INSPECTOR_REDIRECT_URI,
      client_id: client.client_id,
      code_verifier: verifier,
      resource: "http://www.example.com/mcp"
    }
    assert_response :success
    token = response.parsed_body["access_token"]
    assert_equal "read", response.parsed_body["scope"]

    mcp_post({method: "tools/call", params: {name: "whoami", arguments: {}}}, token: token)
    assert_response :success
    assert_equal user.email_address, response.parsed_body.dig("result", "structuredContent", "email")
    assert_equal "read", response.parsed_body.dig("result", "structuredContent", "scope")

<% unless options[:skip_views] -%>
    get connected_apps_path
    assert_includes response.body, client.client_name

<% end -%>
    delete connected_app_path(client)
    assert_response :see_other

    mcp_post({method: "tools/call", params: {name: "whoami", arguments: {}}}, token: token)
    assert_response :unauthorized
  end
end
