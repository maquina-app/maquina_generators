# MCP tools over the Solid Errors store (generated by maquina:solid_errors).
#
# Admin only: a token whose user has no backstage access neither sees nor
# reaches these tools. The reads call FailureTriage in app/agents, the same
# redacted surface as bin/failures. Context and job arguments pass through
# ErrorRedactor before they leave.
<% if write -%>
# resolve_failure is a write tool: it needs a token with the `write` scope.
<% else -%>
# Read-only. `rails g maquina:solid_errors --mcp-write` generates this file with
# a write tool that marks an error resolved (delete this file first).
<% end -%>
module Mcp
  module Tools
    module SolidErrors
      ADMIN_ONLY = true
<% if write -%>
      WRITE_TOOLS = %w[resolve_failure].freeze
<% else -%>
      WRITE_TOOLS = %w[].freeze
<% end -%>

      MAX_LIMIT = 50
      SCHEMA = "https://json-schema.org/draft/2020-12/schema"

      DEFINITIONS = [
        {
          name: "list_failures",
          description: "List unresolved application errors, newest first. Covers request errors and " \
            "background-job failures. Each entry has the fingerprint, exception class, message, " \
            "occurrence count, last_seen (ISO 8601 UTC) and, for a job failure, the job class, job id " \
            "and arguments. Sensitive values read [REDACTED]. Returns at most 50 entries.",
          inputSchema: {
            "$schema": SCHEMA, type: "object",
            properties: {limit: {type: "integer", description: "Number of errors to return, 1-50. Default 20."}},
            required: [], additionalProperties: false
          },
          annotations: {readOnlyHint: true}
        },
        {
          name: "get_failure",
          description: "Full detail for one error by fingerprint: exception class, message, severity, " \
            "source, occurrence count, last_seen (ISO 8601 UTC), the request or job context of the most " \
            "recent occurrence and up to 50 backtrace lines. Sensitive values read [REDACTED]. Get the " \
            "fingerprint from list_failures or top_exceptions.",
          inputSchema: {
            "$schema": SCHEMA, type: "object",
            properties: {fingerprint: {type: "string", description: "Error fingerprint from list_failures or top_exceptions."}},
            required: ["fingerprint"], additionalProperties: false
          },
          annotations: {readOnlyHint: true}
        },
        {
          name: "top_exceptions",
          description: "Unresolved errors with the most occurrences, most frequent first. Same fields as " \
            "list_failures. Returns at most 50 entries.",
          inputSchema: {
            "$schema": SCHEMA, type: "object",
            properties: {limit: {type: "integer", description: "Number of errors to return, 1-50. Default 10."}},
            required: [], additionalProperties: false
          },
          annotations: {readOnlyHint: true}
<% if write -%>
        },
        {
          name: "resolve_failure",
          description: "Mark one error resolved by fingerprint. It leaves list_failures and " \
            "top_exceptions, and Solid Errors reopens it if it happens again, so resolve an error " \
            "once its cause is fixed. resolved_at is ISO 8601 UTC. Get the fingerprint from " \
            "list_failures or top_exceptions.",
          inputSchema: {
            "$schema": SCHEMA, type: "object",
            properties: {fingerprint: {type: "string", description: "Error fingerprint from list_failures or top_exceptions."}},
            required: ["fingerprint"], additionalProperties: false
          },
          annotations: {readOnlyHint: false}
<% end -%>
        }
      ].freeze

      def self.list_failures(scope:, limit: 20)
        overview = ::FailureTriage.overview(limit: capped(limit))

        {failures: overview[:exceptions].map { |error| with_utc_times(error) }, generated_at: utc(overview[:generated_at])}
      end

      def self.get_failure(scope:, fingerprint:)
        with_utc_times(::FailureTriage.exception(fingerprint))
      end

      def self.top_exceptions(scope:, limit: 10)
        {top_exceptions: ::FailureTriage.top(limit: capped(limit))[:top_exceptions].map { |error| with_utc_times(error) }}
      end

<% if write -%>
      def self.resolve_failure(scope:, fingerprint:)
        error = ::SolidErrors::Error.find_by!(fingerprint: fingerprint)
        error.update!(resolved_at: Time.current) unless error.resolved_at
        Rails.logger.info("[MCP] resolve_failure fingerprint=#{error.fingerprint} user_id=#{scope.user.id}")

        {fingerprint: error.fingerprint, exception: error.exception_class, resolved_at: utc(error.resolved_at)}
      end

<% end -%>
      def self.capped(limit) = limit.to_i.clamp(1, MAX_LIMIT)

      def self.utc(time) = time&.utc&.iso8601

      def self.with_utc_times(error) = error.merge(last_seen: utc(error[:last_seen])).compact

      private_class_method :capped, :utc, :with_utc_times
    end
  end
end
