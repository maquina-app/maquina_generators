# frozen_string_literal: true

# Rack::Attack configuration
# https://github.com/rack/rack-attack
#
# Coarse scanner-blocking only; per-action throttling belongs in controllers
# via `rate_limit`. Counters and bans live in Rails.cache (Solid Cache in
# production), so `SolidCache::Entry.where("key LIKE '%rack::attack%'")` is
# the forensic record — the middleware answers before Rails, so nothing here
# reaches the request log except through the subscriber at the bottom.

# Safelist localhost
Rack::Attack.safelist("allow-localhost") do |req|
  req.ip == "127.0.0.1" || req.ip == "::1"
end

# ---------------------------------------------------------------------------
# Blocklist — common vulnerability scanner paths, with a ban
# ---------------------------------------------------------------------------
#
# A scanner sprays hundreds of guesses in a couple of minutes (a thousand
# WordPress REST probes in under five minutes from one address is ordinary).
# Refusing the matching path alone lets every other guess through to routing
# until the general throttle catches up, so the third scanner path bans the IP
# for a week — long enough to outlast a rented scanner host, short enough that
# a reassigned cloud address is not refused for the next tenant.
#
# Backup-archive guesses count as scanner paths too (`/<word>.zip` by the
# hundred in a few seconds). Files the app really serves live under
# /rails/active_storage, so that prefix is exempt.

class Rack::Attack
  # PHP file requests
  PHP_PATH = /\.php\d?$/i

  # Backup and dump guesses (`/backup.zip`, `/db.sql.gz`, `/site.tar.gz`)
  ARCHIVE_PATH = /\.(zip|rar|7z|tar|tgz|gz|bz2|xz|sql|bak|backup|old)$/i

  # WordPress paths
  WORDPRESS_PATHS = %w[
    /wp-admin
    /wp-login
    /wp-content
    /wp-includes
    /wp-json
    /xmlrpc.php
    /wp-config
    /wp-cron
  ].freeze

  # Sensitive file access — anywhere in the path, since scanners probe them behind
  # prefixes too (`/@fs/.env`, `/wp/.git/config`)
  SENSITIVE_PATTERNS = %w[
    /.env
    /.git
    /.htaccess
    /.htpasswd
    /.aws
    /.ssh
    /.svn
  ].freeze

  # Common scanner targets
  SCANNER_PATHS = %w[
    /cgi-bin
    /phpmyadmin
    /pma
    /myadmin
    /phpinfo
    /mysqladmin
    /admin/config.php
    /solr/
    /actuator
    /telescope/requests
    /debug
    /_ignition
    /vendor/phpunit
  ].freeze

  # Server-status and developer-console pages, at the root: 458 observed
  # events. Apache's server-status, Rails' info pages, and the .axd handlers
  # ASP.NET exposes.
  SERVER_INFO_PATHS = %r{
    (^|/)(server-status|server-info|nginx_status|elmah\.axd|trace\.axd
      |phpinfo|info\.php)
    |
    (^|/)(__debug__|__env\.js|__config\.js)
  }xi

  # API documentation and health endpoints that a scanner fishes for:
  # 144 observed events for /swagger.json alone. The names are specific
  # enough that a real app is unlikely to serve them at the root, and the
  # route guard stands them down if it does.
  API_DOC_PATHS = %r{
    (^|/)(swagger\.json|swagger-ui|openapi\.json|openapi\.ya?ml
      |api-docs|api-docs\.json|graphql\.json)
  }xi

  # The scanner ban's three knobs.
  SCANNER_MAXRETRY = 3
  SCANNER_FINDTIME = 10.minutes
  SCANNER_BANTIME = 7.days

  # An address still sending at twice the general throttle's limit has ignored
  # every 429 since it hit the limit: banned for a day. A day rather than the
  # scanner's week because a shared address (office, carrier NAT) can land here.
  GENERAL_LIMIT = 300
  GENERAL_PERIOD = 5.minutes
  FLOOD_MAXRETRY = GENERAL_LIMIT * 2
  FLOOD_BANTIME = 1.day

  # Sign-in throttle.
  LOGIN_PATH = "<%= options[:login_path] %>"
  LOGIN_LIMIT = 5
  LOGIN_PERIOD = 20.seconds

  # -------------------------------------------------------------------------
  # What a scanner is actually after
  # -------------------------------------------------------------------------
  #
  # The list above names the classic targets (WordPress, `.env`, `phpinfo`).
  # These name the ones a modern scanner reaches for first, measured against
  # 30,703 refused requests collected from five production apps: cloud
  # provider keys, container runtime internals, dev-server artefacts, and
  # infrastructure as code.
  #
  # The list is the TRIGGER for the ban, not the filter. Rack::Attack's
  # Fail2Ban.filter returns true for every path once the ban is written, so
  # the list only has to name the FIRST path a scanner touches -- the rest of
  # its run is refused anyway. Extending the list moves the ban from the
  # fourth probe to the first, and from a 429 (throttle) to a 403 (ban).
  #
  # With the list as it was, it named 5.2% of the observed attack traffic.
  # With these, 58.7%.

  # Cloud provider credentials: 3,068 observed events.
  CLOUD_KEY_PATHS = %r{
    (^|/)(
      (firebase|gcp|google|aws|azure|aliyun|cloudflare|heroku|vercel|netlify)[-_]?
        (admin|service|credentials|key|config|token)?[a-z_-]*
      | service[_-]?account
      | serviceaccount
      | credentials
      | creds
      | sa
    )\.(json|ya?ml|env|ini|conf|txt)
  }xi

  # Private key material: 609 observed events. The public-key exceptions
  # matter -- an app may serve /public_key.pem on purpose, and blocking that
  # breaks the page.
  #
  # The name is matched at the root too ("/key.json", "/server.key").
  PRIVATE_KEY_PATHS = %r{
    (^|/)([^/]+\.(pem|key|p12|pfx|p8|jks|keystore|kdbx)
      | key\.json
      | rclone\.conf
    )
  }xi
  PUBLIC_KEY_EXCEPTIONS = %r{/(public|pub)[_-]?key}i

  # Kubernetes and container runtime: 1,162 observed events. The highest-value
  # target in the set -- a leaked service-account token is a cluster credential.
  CONTAINER_PATHS = %r{
    (/var/run/secrets
     | /proc/self/(environ|cwd|fd)
     | /proc/1/environ
     | /\.dockerenv
     | /etc/(hostname|resolv\.conf|passwd|shadow)
    )
  }xi

  # Infrastructure as code: 986 observed events. A docker-compose.yml or a
  # terraform.tfstate names the whole stack.
  #
  # The name is matched at the root too ("/Dockerfile"), which is where a
  # scanner looks first -- so the pattern is a name, not a path.
  IAC_PATHS = %r{
    (^|/)(dockerfile|docker-compose|compose)(\.(ya?ml|yml))?
    |
    (^|/)terraform\.(tfstate|tfvars|hcl)
    |
    (^|/)serverless\.ya?ml
    |
    (^|/)(values|helmfile|kustomization)\.ya?ml
    |
    (^|/)(ansible|consul|nomad|vault)\.?(hcl|json|ya?ml)
  }xi

  # Bare secret files: 981 observed events. NOT the same as /\.env/ above --
  # these have no dot in front.
  SECRET_FILE_PATHS = %r{
    (^|/)(secrets?|credentials?|passwords?|passwd)
      ([._-][a-z0-9]+)?
      \.(json|ya?ml|env|ini|conf|txt|xml)
  }xi

  # Environment and config dumps: 1,314 observed events. These are the files a
  # JavaScript SPA leaks, and they are looked for at the root of the site.
  CONFIG_DUMP_PATHS = %r{
    (^|/)(
      env\.js|env\.json|runtime-config|runtime_config|settings\.json
      |config\.json|app-config\.json|app\.config\.js|push_config\.json
      |configuration\.js|settings\.js|constants\.js|environment\.js
      |manifest\.webmanifest|ngsw\.json|service-worker\.js|sw\.js
    )
  }xi

  # Dotfile credentials: 730 observed events.
  DOTFILE_CRED_PATHS = %r{
    /\.(bashrc|zshrc|profile|bash_profile|bash_history|npmrc|yarnrc
      |pypirc|netrc|dockerignore|gitignore|gitconfig|editorconfig)
    |
    /\.aws/credentials
    |
    /config/gcloud
  }xi

  # Dev server and bundler artefacts: 1,805 observed events. Vite's /@fs/
  # escapes the served directory, which is why /@fs/var/run/secrets/... shows
  # up in the data.
  DEV_SERVER_PATHS = %r{
    (__vite_rsc_
     | /@fs/
     | /@id/
     | /_profiler/
     | /__open-in-editor
     | /__inspect
     | /_astro/
     )
  }xi

  # Source maps: 543 observed events. Only the JS/CSS extensions are matched,
  # so an app that ships a map on purpose is not caught.
  SOURCE_MAP_PATHS = %r{\.(js|mjs|css)\.map$}xi

  # Path traversal: 1,529 observed events, in several encodings.
  TRAVERSAL_PATHS = %r{(\.\.|%2e%2e|%2f|..%2f|%252f|%255c)}xi

  # Scanner applications, by product signature: 1,014 observed events.
  # Product paths, not a generic /api prefix -- an app's own /api/users is not
  # a match.
  #
  # The alternatives are deliberately narrow. "admin", "users" and "settings"
  # were removed after a check against the real route tables of five
  # production apps: they collided with a real /admin console and a real
  # /api/v1/... API. The route guard below covers the remaining risk, but a
  # pattern that breaks a real route is not worth keeping.
  SCANNER_APP_PATHS = %r{
    # Metabase
    ^/api/(user|setup|session|permissions|email|logs
          |database|table|public|geo|llm|action|dataset|card|query|collection)
    |
    # NocoDB
    ^/api/(v[12]/)?(meta|auth/user|auth/signup|auth/signin|roles|tables|views
          |shared|users|datasources|projects)
    |
    # Appsmith
    ^/api/(configs|pages|actions|git|assets|themes|organizations|bootstrap)
    |
    # Strapi
    ^/api/(roles|permissions|content-types|components
          |content-manager|upload|i18n|webhooks)
    |
    # Directus (its /graphql is caught by GRAPHQL_PATHS)
    ^/(server/(info|health|ping)|users/me|files|dashboards
        |collections|schema)
    |
    # Kong
    ^/(apis|consumers|plugins|routes|services|credentials|targets|status)
    |
    # Vault
    ^/v1/(sys|auth|secret|identity|health)
    |
    # Grafana
    ^/grafana/(api|login|admin|public)
    |
    # Jenkins. "/login" and "/view" are ordinary words in an app's route
    # table, so they are left out: the route guard covers them, and a rule
    # that blocks a real sign-in page is not worth keeping.
    ^/(script|job|build|api/json|whoAmI|computer|descriptorByName)
    |
    # Keycloak
    ^/(realms|resources|protocol)
    |
    # Nextcloud / ownCloud
    ^/(index\.php|status\.php|remote\.php|ocs/v[12]|public\.php|core/ajax)
    |
    # SonarQube
    ^/(api/v2|api/issues|api/webservices|sonar)
    |
    # Supabase
    ^/(rest/v1|auth/v1|storage/v1|functions/v1|pg/)
  }xi

  # GraphQL: 1,313 observed events. NOT a route in any app measured.
  #
  # The route guard handles this automatically: an app that serves /graphql
  # is not under attack for it, and the guard stands the rule down. Set
  # GRAPHQL_IS_ROUTE to true only for an app that serves GraphQL AND has a
  # catch-all route, where the guard cannot tell the two apart.
  GRAPHQL_PATHS = %r{^/(v\d+/)?(api/)?graphql}xi
  GRAPHQL_IS_ROUTE = false

  # The encodings a scanner uses to hide a path. Normalising them once means
  # the patterns above match a path however it is spelled.
  ENCODED_DOTS = /%2e/i
  ENCODED_SLASHES = /%2f|%5c|%252f/i

  def self.scanner_path?(path)
    path = path.to_s.downcase.squeeze("/")
    return false if path.start_with?("/rails/active_storage")

    # Unhide the path before matching: /api/orders/..%2Fadmin/config.json
    # becomes /api/orders/../admin/config.json.
    path = path.gsub(ENCODED_DOTS, ".").gsub(ENCODED_SLASHES, "/")

    # An app that serves GraphQL is not under attack for it.
    return false if GRAPHQL_IS_ROUTE && path.match?(GRAPHQL_PATHS)

    path.match?(PHP_PATH) ||
      path.match?(ARCHIVE_PATH) ||
      path.match?(CLOUD_KEY_PATHS) ||
      (path.match?(PRIVATE_KEY_PATHS) && !path.match?(PUBLIC_KEY_EXCEPTIONS)) ||
      path.match?(CONTAINER_PATHS) ||
      path.match?(IAC_PATHS) ||
      path.match?(SECRET_FILE_PATHS) ||
      path.match?(CONFIG_DUMP_PATHS) ||
      path.match?(DOTFILE_CRED_PATHS) ||
      path.match?(DEV_SERVER_PATHS) ||
      path.match?(SOURCE_MAP_PATHS) ||
      path.match?(SERVER_INFO_PATHS) ||
      path.match?(API_DOC_PATHS) ||
      path.match?(TRAVERSAL_PATHS) ||
      path.match?(SCANNER_APP_PATHS) ||
      path.match?(GRAPHQL_PATHS) ||
      WORDPRESS_PATHS.any? { |prefix| path.start_with?(prefix) } ||
      SENSITIVE_PATTERNS.any? { |dotfile| path.include?(dotfile) } ||
      path.include?("/etc/passwd") ||
      path.include?("/etc/shadow") ||
      SCANNER_PATHS.any? { |prefix| path.start_with?(prefix) }
  end

  # What the general throttle and the flood ban count: every request but
  # assets and Active Storage, by IP.
  def self.counted_ip(req)
    req.ip unless req.path.start_with?("/assets", "/rails/active_storage")
  end

  # -------------------------------------------------------------------------
  # The route guard
  # -------------------------------------------------------------------------
  #
  # A path rule that matches a route the app really serves is a rule that
  # breaks the site. The patterns above are broad on purpose (they name whole
  # families -- cloud keys, container runtime, scanner products), so they need a
  # way to back off when the app itself owns the path.
  #
  # This asks the app: is this path one of mine? If the app routes it, the
  # rule stands down. It is what makes the broad patterns safe to install
  # without knowing the app's routes in advance.
  #
  # Two things it will not do:
  #
  #   * It does not protect a path the app serves ONLY through a catch-all
  #     (`match "*path"`). With a catch-all, almost every path "matches" the
  #     app, and the guard would disable itself. So when a catch-all is
  #     present the guard stands down entirely and the patterns decide.
  #
  #   * It does not protect a path served by another service on the same
  #     domain (a reverse proxy in front, a subdomain). Those are not in the
  #     app's route table.
  #
  # The route table is read once, on the first request, and cached. It is not
  # available at initializer time (Rails loads routes after initializers), so
  # it cannot be resolved when the rules are installed.
  def self.route_guard?
    return @route_guard unless @route_guard.nil?

    @route_guard = begin
      paths = Rails.application.routes.routes.map { |route| route.path.spec.to_s }
      # A catch-all at the ROOT makes the guard meaningless: every path would
      # "match" the app, so the guard would disable itself. A scoped glob
      # ("/app/solid_errors(/*path)") only covers its own prefix and is fine.
      # The glob can carry the format suffix ("/*path(.:format)"), so match
      # the segment, not the string.
      root_catchall = paths.any? do |path|
        first = path.split("/").reject(&:empty?).first.to_s
        first.include?("*")
      end
      !root_catchall
    rescue StandardError
      # If the route table cannot be read, stand down rather than guess: the
      # patterns are still the first line, and a false block is worse.
      false
    end
  end

  # Does the app itself route this path? Compares the request path against the
  # app's route patterns, treating a dynamic segment as a wildcard.
  #
  # A dynamic segment at the ROOT is NOT counted as "the app routes this".
  # A route like "/:slug" matches every single-segment path, so `/.env` and
  # `/key.pem` would look like the app's own pages and the guard would stand
  # the rule down for exactly the paths it exists to catch. A root segment
  # must be a LITERAL to count.
  def self.app_route?(path)
    return false unless route_guard?

    segments = path.to_s.downcase.split("/").reject(&:empty?)
    Rails.application.routes.routes.any? do |route|
      pattern = route.path.spec.to_s.sub(/\(\.:format\)\z/, "").downcase
      pattern_segments = pattern.split("/").reject(&:empty?)
      next false if pattern_segments.size != segments.size

      pattern_segments.each_with_index.all? do |segment, index|
        next false if index.zero? && segment.start_with?(":")
        segment.start_with?(":") || segment.include?("*") || segment == segments[index]
      end
    end
  rescue StandardError
    false
  end

  def self.banned?(ip)
    Fail2Ban.banned?("scanner:#{ip}") || Allow2Ban.banned?("flood:#{ip}")
  end
end

Rack::Attack.blocklist("fail2ban/scanners") do |req|
  Rack::Attack::Fail2Ban.filter("scanner:#{req.ip}",
    maxretry: Rack::Attack::SCANNER_MAXRETRY, findtime: Rack::Attack::SCANNER_FINDTIME, bantime: Rack::Attack::SCANNER_BANTIME) do
    # The route guard stands down when the app itself routes the path: a rule
    # that blocks a real route is a rule that breaks the site.
    Rack::Attack.scanner_path?(req.path) && !Rack::Attack.app_route?(req.path)
  end
end

# Blocklists run before throttles, so this counts the requests the throttle
# goes on to refuse as well.
Rack::Attack.blocklist("allow2ban/flood") do |req|
  if (ip = Rack::Attack.counted_ip(req))
    Rack::Attack::Allow2Ban.filter("flood:#{ip}",
      maxretry: Rack::Attack::FLOOD_MAXRETRY, findtime: Rack::Attack::GENERAL_PERIOD, bantime: Rack::Attack::FLOOD_BANTIME) { true }
  end
end

# ---------------------------------------------------------------------------
# Throttles
# ---------------------------------------------------------------------------

# General rate limit: 300 requests per 5 minutes per IP
#
# Active Storage is exempt alongside /assets. A page of proxied images is dozens
# of requests, and a refusal there renders as a broken image. Every one of those
# requests is already gated by an unguessable signed id.
Rack::Attack.throttle("req/ip", limit: Rack::Attack::GENERAL_LIMIT, period: Rack::Attack::GENERAL_PERIOD) do |req|
  Rack::Attack.counted_ip(req)
end

# Login throttle: 5 attempts per 20 seconds per IP
Rack::Attack.throttle("login/ip", limit: Rack::Attack::LOGIN_LIMIT, period: Rack::Attack::LOGIN_PERIOD) do |req|
  req.ip if req.path == Rack::Attack::LOGIN_PATH && req.post?
end

# ---------------------------------------------------------------------------
# Custom responses
# ---------------------------------------------------------------------------

# Return 403 Forbidden for blocklisted requests
Rack::Attack.blocklisted_responder = lambda do |_request|
  [403, {"content-type" => "text/plain"}, ["Forbidden\n"]]
end

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Every refused request is logged with its IP — the only trace it leaves in the
# app's log. Safelist matches stay silent.
ActiveSupport::Notifications.subscribe("rack.attack") do |_name, _start, _finish, _id, payload|
  req = payload[:request]
  match_type = req.env["rack.attack.match_type"]
  next unless %i[blocklist throttle].include?(match_type)

  Rails.logger.warn "[ATTACK] #{match_type} #{req.env["rack.attack.matched"]} #{req.ip} #{req.request_method} #{req.path}"
end
