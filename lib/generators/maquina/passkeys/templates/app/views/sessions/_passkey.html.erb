<div data-controller="passkey-sign-in"
     data-action="turbo:morph@document->passkey-sign-in#refresh"
     data-passkey-sign-in-challenge-url-value="<%= session_passkey_challenge_path %>"
     data-passkey-sign-in-url-value="<%= session_passkey_path %>"
     data-passkey-sign-in-error-message-value="<%= t("sessions.passkey.error") %>"
     class="mt-6 space-y-4">
  <div class="flex items-center gap-3 text-sm text-muted-foreground">
    <span class="h-px flex-1 bg-border"></span>
    <%= t("sessions.passkey.or") %>
    <span class="h-px flex-1 bg-border"></span>
  </div>

  <button type="button"
          data-action="passkey-sign-in#signIn"
          data-passkey-sign-in-target="button"
          data-component="button"
          data-variant="outline"
          class="w-full px-4 py-3 text-base font-medium text-foreground bg-background border border-input hover:bg-accent rounded-lg transition-colors cursor-pointer disabled:opacity-50">
    <%= t("sessions.passkey.sign_in") %>
  </button>

  <p data-passkey-sign-in-target="error" class="text-sm text-destructive text-center" role="alert" hidden></p>
</div>
