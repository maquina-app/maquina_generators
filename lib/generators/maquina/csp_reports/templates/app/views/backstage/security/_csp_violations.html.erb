<%# locals: (report:) %>
<%# Content Security Policy violations browsers reported to /csp-reports
    (maquina:csp_reports), grouped so each row is one thing to fix. %>
<%= render "components/card" do %>
  <%= render "components/card/header" do %>
    <%= render "components/card/title", text: "Content Security Policy violations" %>
    <%= render "components/card/description",
          text: "#{number_with_delimiter(report.total)} reported in the last #{report.window.inspect}, kept for #{Security::CspViolation::RETENTION.inspect}. Most frequent first." %>
  <% end %>
  <%= render "components/card/content", spacing: :full do %>
    <% if report.empty? %>
      <%= empty_state(title: "No violation was reported.", icon: :check_circle, size: :compact) %>
    <% else %>
      <div class="overflow-x-auto">
        <%= render "components/table", container: false, "aria-label": "Content Security Policy violations" do %>
          <%= render "components/table/header" do %>
            <%= render "components/table/row" do %>
              <%= render "components/table/head", text: "Directive" %>
              <%= render "components/table/head", text: "Blocked" %>
              <%= render "components/table/head", text: "Page" %>
              <%= render "components/table/head", text: "Reports", css_classes: "text-right" %>
              <%= render "components/table/head", text: "Last seen" %>
            <% end %>
          <% end %>
          <%= render "components/table/body" do %>
            <% report.top.each do |group| %>
              <%= render "components/table/row" do %>
                <%= render "components/table/cell", css_classes: "font-mono", text: group.effective_directive %>
                <%= render "components/table/cell", css_classes: "font-mono whitespace-normal break-all", text: group.blocked_uri.presence || "—" %>
                <%= render "components/table/cell", css_classes: "font-mono whitespace-normal break-all", text: group.document_uri.presence || "—" %>
                <%= render "components/table/cell", css_classes: "text-right tabular-nums", text: number_with_delimiter(group.count) %>
                <%= render "components/table/cell" do %>
                  <%= render "backstage/security/utc_time", time: group.last_seen %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
