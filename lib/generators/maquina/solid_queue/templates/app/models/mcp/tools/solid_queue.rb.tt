# MCP tools over Solid Queue (generated by maquina:solid_queue).
#
# Admin only: a member's token neither sees nor reaches these tools. Job
# arguments pass through ErrorRedactor (app/agents) before they leave.
<% if write -%>
# retry_failed_job is a write tool: it needs a token with the `write` scope.
<% else -%>
# Read-only. `rails g maquina:solid_queue --mcp-write` generates this file with
# a write tool that retries a failed job (delete this file first).
<% end -%>
module Mcp
  module Tools
    module SolidQueue
      ADMIN_ONLY = true
<% if write -%>
      WRITE_TOOLS = %w[retry_failed_job].freeze
<% else -%>
      WRITE_TOOLS = %w[].freeze
<% end -%>

      MAX_LIMIT = 50
      BACKTRACE_LIMIT = 50
      SCHEMA = "https://json-schema.org/draft/2020-12/schema"

      DEFINITIONS = [
        {
          name: "queue_status",
          description: "Per Solid Queue queue: the number of jobs ready to run, scheduled for later and " \
            "failed, and whether the queue is paused. Queues are sorted by name. generated_at is " \
            "ISO 8601 UTC.",
          inputSchema: {
            "$schema": SCHEMA, type: "object",
            properties: {}, required: [], additionalProperties: false
          },
          annotations: {readOnlyHint: true}
        },
        {
          name: "list_failed_jobs",
          description: "Failed background jobs, most recent failure first. Each entry has the job id, job " \
            "class, queue, exception class, error message, failed_at and enqueued_at (ISO 8601 UTC). " \
            "Returns at most 50 entries. Use get_failed_job for the arguments and backtrace.",
          inputSchema: {
            "$schema": SCHEMA, type: "object",
            properties: {
              queue: {type: "string", description: "Only jobs from this queue name. Default: every queue."},
              limit: {type: "integer", description: "Number of jobs to return, 1-50. Default 20."}
            },
            required: [], additionalProperties: false
          },
          annotations: {readOnlyHint: true}
        },
        {
          name: "get_failed_job",
          description: "Full detail for one failed job by job id: job class, queue, priority, attempts so " \
            "far, the job arguments, exception class, error message, up to 50 backtrace lines and its " \
            "times (ISO 8601 UTC). Sensitive argument values read [REDACTED]. Get the id from " \
            "list_failed_jobs.",
          inputSchema: {
            "$schema": SCHEMA, type: "object",
            properties: {id: {type: "integer", description: "Job id from list_failed_jobs."}},
            required: ["id"], additionalProperties: false
          },
          annotations: {readOnlyHint: true}
<% if write -%>
        },
        {
          name: "retry_failed_job",
          description: "Retry one failed job by job id: the job goes back to its queue with its attempt " \
            "counters reset and leaves the failed list. It runs again with the same arguments, so only " \
            "retry a job once the cause of the failure is fixed. Get the id from list_failed_jobs.",
          inputSchema: {
            "$schema": SCHEMA, type: "object",
            properties: {id: {type: "integer", description: "Job id from list_failed_jobs."}},
            required: ["id"], additionalProperties: false
          },
          annotations: {readOnlyHint: false}
<% end -%>
        }
      ].freeze

      def self.queue_status(scope:)
        ready = ::SolidQueue::ReadyExecution.group(:queue_name).count
        scheduled = ::SolidQueue::ScheduledExecution.group(:queue_name).count
        failed = ::SolidQueue::FailedExecution.joins(:job).group(::SolidQueue::Job.arel_table[:queue_name]).count
        paused = ::SolidQueue::Pause.pluck(:queue_name)

        queues = (ready.keys | scheduled.keys | failed.keys | paused).sort.map do |name|
          {name: name, ready: ready.fetch(name, 0), scheduled: scheduled.fetch(name, 0),
           failed: failed.fetch(name, 0), paused: paused.include?(name)}
        end

        {queues: queues, generated_at: utc(Time.current)}
      end

      def self.list_failed_jobs(scope:, queue: nil, limit: 20)
        executions = ::SolidQueue::FailedExecution.includes(:job).order(created_at: :desc, id: :desc).limit(capped(limit))
        executions = executions.joins(:job).merge(::SolidQueue::Job.where(queue_name: queue)) if queue

        {failed_jobs: executions.map { |execution| summary(execution) }}
      end

      def self.get_failed_job(scope:, id:)
        execution = ::SolidQueue::FailedExecution.includes(:job).find_by!(job_id: id)
        job = execution.job
        serialized = job.arguments || {}

        summary(execution).merge(
          priority: job.priority,
          executions: serialized["executions"],
          arguments: ::ErrorRedactor.redact(serialized["arguments"]),
          scheduled_at: utc(job.scheduled_at),
          backtrace: Array(execution.backtrace).first(BACKTRACE_LIMIT)
        ).compact
      end
<% if write -%>

      def self.retry_failed_job(scope:, id:)
        execution = ::SolidQueue::FailedExecution.includes(:job).find_by!(job_id: id)
        execution.retry
        Rails.logger.info("[MCP] retry_failed_job job_id=#{id} user_id=#{scope.user.id}")

        {id: id, job_class: execution.job.class_name, queue: execution.job.queue_name, retried: true}
      end
<% end -%>

      def self.summary(execution)
        job = execution.job

        {id: job.id, job_class: job.class_name, queue: job.queue_name,
         exception_class: execution.exception_class, message: execution.message,
         failed_at: utc(execution.created_at), enqueued_at: utc(job.created_at)}
      end

      def self.capped(limit) = limit.to_i.clamp(1, MAX_LIMIT)

      def self.utc(time) = time&.utc&.iso8601

      private_class_method :summary, :capped, :utc
    end
  end
end
