require "test_helper"

# The <%= tool_name %> MCP tool (generated by maquina:mcp_tool).
class <%= test_class_name %> < ActionDispatch::IntegrationTest
  setup do
    @token = oauth_token_for(users(:mcp_member), scope: "read")
  end

  test "<%= tool_name %> is listed for a read token" do
    mcp_post({method: "tools/list"}, token: @token)

    assert_includes response.parsed_body.dig("result", "tools").map { |tool| tool["name"] }, "<%= tool_name %>"
  end
<% if required_arguments.any? -%>

  test "a call without <%= required_arguments.first[:name] %> is invalid params" do
    mcp_post({method: "tools/call", params: {name: "<%= tool_name %>", arguments: <%= arguments_literal(except: required_arguments.first[:name]) %>}}, token: <%= options[:write] ? %(oauth_token_for(users(:mcp_member), scope: "read write")) : "@token" %>)

    assert_equal(-32602, response.parsed_body.dig("error", "code"))
    assert_includes response.parsed_body.dig("error", "message"), "<%= required_arguments.first[:name] %>"
  end
<% else -%>

  test "a call with an argument the schema does not declare is invalid params" do
    mcp_post({method: "tools/call", params: {name: "<%= tool_name %>", arguments: {undeclared: 1}}}, token: <%= options[:write] ? %(oauth_token_for(users(:mcp_member), scope: "read write")) : "@token" %>)

    assert_equal(-32602, response.parsed_body.dig("error", "code"))
  end
<% end -%>
<% if options[:write] -%>

  test "a read-only token cannot call <%= tool_name %>" do
    mcp_post({method: "tools/call", params: {name: "<%= tool_name %>", arguments: <%= arguments_literal %>}}, token: @token)

    assert_response :forbidden
    assert_match(/error="insufficient_scope"/, response.headers["WWW-Authenticate"])
  end
<% end -%>

  test "another user's record is not found" do
    skip "TODO: create a record owned by users(:mcp_other) and pass its id to <%= tool_name %>"

    # other = users(:mcp_other).posts.create!(title: "Not yours")
    # mcp_post({method: "tools/call", params: {name: "<%= tool_name %>", arguments: {id: other.id}}}, token: @token)
    #
    # assert response.parsed_body.dig("result", "isError")
    # assert_equal Mcp::ToolError::NOT_FOUND, response.parsed_body.dig("result", "content", 0, "text")
  end
end
