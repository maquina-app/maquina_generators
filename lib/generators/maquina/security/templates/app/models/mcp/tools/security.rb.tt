# MCP tools over the Rack::Attack refusals the security database records
# (generated by maquina:security).
#
# Admin only: a token whose user has no backstage access neither sees nor
# reaches these tools.
<% if write -%>
# unban_address is a write tool: it needs a token with the `write` scope.
<% else -%>
# Read-only. `rails g maquina:security --mcp-write` generates this file with a
# write tool that lifts a ban (delete this file first).
<% end -%>
module Mcp
  module Tools
    module Security
      ADMIN_ONLY = true
<% if write -%>
      WRITE_TOOLS = %w[unban_address].freeze
<% else -%>
      WRITE_TOOLS = %w[].freeze
<% end -%>

      MAX_LIMIT = 50
      MAX_HOURS = 720
      SCHEMA = "https://json-schema.org/draft/2020-12/schema"

      DEFINITIONS = [
        {
          name: "recent_blocks",
          description: "Requests Rack::Attack refused, newest first. kind is throttled (over a rate limit), " \
            "blocked (a scanner path) or banned (refused because the address is banned). Each entry has " \
            "the kind, the rule that refused it, the IP address, method, host, path, user agent, at " \
            "(ISO 8601 UTC) and banned_now, whether the address is banned at this moment. Events are " \
            "kept for 30 days. Returns at most 50 entries.",
          inputSchema: {
            "$schema": SCHEMA, type: "object",
            properties: {limit: {type: "integer", description: "Number of events to return, 1-50. Default 20."}},
            required: [], additionalProperties: false
          },
          annotations: {readOnlyHint: true}
        },
        {
          name: "security_summary",
          description: "Counts of refused requests over the last hours: the total, the count per kind " \
            "(throttled, blocked, banned), the count per rule and kind, busiest first, and the number of " \
            "distinct IP addresses. since is the window start in ISO 8601 UTC.",
          inputSchema: {
            "$schema": SCHEMA, type: "object",
            properties: {hours: {type: "integer", description: "Window length in hours, 1-720. Default 24."}},
            required: [], additionalProperties: false
          },
          annotations: {readOnlyHint: true}
<% if write -%>
        },
        {
          name: "unban_address",
          description: "Lift the scanner ban and the flood ban on one IP address and clear its strike counts, " \
            "for an address banned by mistake. Its recorded refusals stay. was_banned says whether it " \
            "was banned before the call. Get the address from recent_blocks.",
          inputSchema: {
            "$schema": SCHEMA, type: "object",
            properties: {ip: {type: "string", description: "IPv4 or IPv6 address from recent_blocks."}},
            required: ["ip"], additionalProperties: false
          },
          annotations: {readOnlyHint: false}
<% end -%>
        }
      ].freeze

      def self.recent_blocks(scope:, limit: 20)
        events = ::Security::AbuseEvent.recent.limit(limit.to_i.clamp(1, MAX_LIMIT)).to_a
        # Rack::Attack.banned? reads the cache, once per address.
        banned = events.map(&:ip).uniq.index_with { |ip| ::Rack::Attack.banned?(ip) }

        events = events.map do |event|
          {kind: event.kind, rule: event.rule, ip: event.ip, request_method: event.request_method,
           host: event.host, path: event.path, user_agent: event.user_agent,
           at: event.created_at.utc.iso8601, banned_now: banned.fetch(event.ip)}
        end

        {events: events}
      end

      def self.security_summary(scope:, hours: 24)
        hours = hours.to_i.clamp(1, MAX_HOURS)
        since = hours.hours.ago
        events = ::Security::AbuseEvent.where(created_at: since..)
        counts = events.group(:rule, :kind).count

        by_rule = counts.map { |(rule, kind), count| {rule: rule, kind: kind, count: count} }
          .sort_by { |row| [-row[:count], row[:rule], row[:kind]] }

        {hours: hours, since: since.utc.iso8601, total: counts.values.sum,
         by_kind: ::Security::AbuseEvent::KINDS.index_with { |kind| by_rule.sum { |row| (row[:kind] == kind) ? row[:count] : 0 } },
         by_rule: by_rule, addresses: events.distinct.count(:ip)}
      end
<% if write -%>

      def self.unban_address(scope:, ip:)
        # IPAddr also parses a range; a ban is on one address.
        raise IPAddr::InvalidAddressError if ip.include?("/")

        address = IPAddr.new(ip).to_s
        was_banned = ::Rack::Attack.banned?(address)
        ::Rack::Attack.unban!(address)
        Rails.logger.info("[MCP] unban_address ip=#{address} user_id=#{scope.user.id}")

        {ip: address, was_banned: was_banned, banned_now: ::Rack::Attack.banned?(address)}
      rescue IPAddr::InvalidAddressError
        raise Mcp::ToolError, "#{ip} is not an IP address"
      end
<% end -%>
    end
  end
end
