# frozen_string_literal: true

# Rack::Attack's last week, read from the `security` database. Behind the same
# backstage Basic Auth as Solid Errors and Mission Control Jobs, and closed
# (503) until those credentials are configured, so it is never left open.
class Backstage::SecurityController < BackstageController
  layout "backstage/security"

  before_action :require_backstage_credentials
  before_action :authenticate

  def show
    @report = Security::AbuseReport.new
  end

  private

  def authenticate
    authenticate_or_request_with_http_basic("Backstage") do |user, pass|
      secure_match?(user, backstage_username) & secure_match?(pass, backstage_password)
    end
  end

  def require_backstage_credentials
    return if backstage_username.present? && backstage_password.present?

    head :service_unavailable
  end

  def secure_match?(given, expected)
    ActiveSupport::SecurityUtils.secure_compare(given.to_s, expected.to_s)
  end

  def backstage
    @backstage ||= Rails.application.credentials.backstage || {}
  end

  def backstage_username
    backstage[:username] || ENV["<%= options[:user_env_var] %>"]
  end

  def backstage_password
    backstage[:password] || ENV["<%= options[:password_env_var] %>"]
  end
end
