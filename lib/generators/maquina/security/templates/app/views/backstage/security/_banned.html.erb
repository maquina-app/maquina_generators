<%# locals: (banned:) %>
<%# "Banned now" is Rack::Attack's own answer at render time; the rows are the
    refusals recorded while a ban stood, so an expired ban still shows here
    for the week with its badge flipped. %>
<%= render "components/card" do %>
  <%= render "components/card/header" do %>
    <%= render "components/card/title", text: "Banned addresses" %>
    <%= render "components/card/description", text: "#{Rack::Attack::SCANNER_MAXRETRY} scanner paths in #{Rack::Attack::SCANNER_FINDTIME.inspect} bans an address for #{Rack::Attack::SCANNER_BANTIME.inspect}; #{Rack::Attack::FLOOD_MAXRETRY} requests in #{Rack::Attack::GENERAL_PERIOD.inspect}, for #{Rack::Attack::FLOOD_BANTIME.inspect}." %>
  <% end %>
  <%= render "components/card/content", spacing: :full do %>
    <% if banned.empty? %>
      <%= empty_state(title: "No address has been banned.", icon: :check_circle, size: :compact) %>
    <% else %>
      <div class="overflow-x-auto">
        <%= render "components/table", container: false, "aria-label": "Banned addresses" do %>
          <%= render "components/table/header" do %>
            <%= render "components/table/row" do %>
              <%= render "components/table/head", text: "Address" %>
              <%= render "components/table/head", text: "Refused since", css_classes: "text-right" %>
              <%= render "components/table/head", text: "Banned" %>
              <%= render "components/table/head", text: "Since" %>
            <% end %>
          <% end %>
          <%= render "components/table/body" do %>
            <% banned.each do |address| %>
              <%= render "components/table/row" do %>
                <%= render "components/table/cell", css_classes: "font-mono", text: address.ip %>
                <%= render "components/table/cell", css_classes: "text-right tabular-nums", text: number_with_delimiter(address.count) %>
                <%= render "components/table/cell" do %>
                  <% if address.banned_now? %>
                    <%= render "components/badge", variant: :destructive, size: :sm do %>Banned now<% end %>
                  <% else %>
                    <%= render "components/badge", variant: :outline, size: :sm do %>Expired<% end %>
                  <% end %>
                <% end %>
                <%= render "components/table/cell" do %>
                  <%= render "backstage/security/utc_time", time: address.first_banned_at %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
