<%# locals: (title:, description:, addresses:, empty:) %>
<%= render "components/card" do %>
  <%= render "components/card/header" do %>
    <%= render "components/card/title", text: title %>
    <%= render "components/card/description", text: description %>
  <% end %>
  <%= render "components/card/content", spacing: :full do %>
    <% if addresses.empty? %>
      <%= empty_state(title: empty, icon: :check_circle, size: :compact) %>
    <% else %>
      <div class="overflow-x-auto">
        <%= render "components/table", container: false, "aria-label": title do %>
          <%= render "components/table/header" do %>
            <%= render "components/table/row" do %>
              <%= render "components/table/head", text: "Address" %>
              <%= render "components/table/head", text: "Refused", css_classes: "text-right" %>
              <%= render "components/table/head", text: "Rules" %>
              <%= render "components/table/head", text: "Last seen" %>
            <% end %>
          <% end %>
          <%= render "components/table/body" do %>
            <% addresses.each do |address| %>
              <%= render "components/table/row" do %>
                <%= render "components/table/cell", css_classes: "font-mono", text: address.ip %>
                <%= render "components/table/cell", css_classes: "text-right tabular-nums", text: number_with_delimiter(address.count) %>
                <%= render "components/table/cell", text: address.rules.join(", ") %>
                <%= render "components/table/cell" do %>
                  <%= render "backstage/security/utc_time", time: address.last_seen %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
