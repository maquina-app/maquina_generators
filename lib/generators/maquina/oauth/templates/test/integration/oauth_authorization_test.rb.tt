require "test_helper"
require_relative "../test_helpers/session_test_helper"

# The consent screen (generated by maquina:oauth).
class OauthAuthorizationTest < ActionDispatch::IntegrationTest
  setup do
    @verifier, @challenge = pkce_pair
  end

  test "a signed-out visitor comes back to the exact authorize URL" do
    get new_oauth_authorization_path(authorize_params(challenge: @challenge))

    assert_redirected_to new_session_path
    # Clave's sign-in returns here after the email code, every parameter intact.
    assert_equal new_oauth_authorization_url(authorize_params(challenge: @challenge)), session[:return_to_after_authenticating]
<% unless options[:skip_views] -%>

    sign_in_as users(:mcp_member)
    get session[:return_to_after_authenticating]

    assert_response :success
    assert_select "input[type=hidden][name=state][value=?]", "xyz-state"
    assert_select "input[type=hidden][name=code_challenge][value=?]", @challenge
    assert_select "input[type=hidden][name=resource][value=?]", MCP_RESOURCE
<% end -%>
  end

<% unless options[:skip_views] -%>
  test "shows who is asking and for what" do
    sign_in_as users(:mcp_member)
    get new_oauth_authorization_path(authorize_params(challenge: @challenge, scope: "read write"))

    assert_response :success
    assert_select "h1", I18n.t("oauth.authorizations.new.title", client_name: "MCP Inspector")
    assert_select "p", "inspector.example.com"
    assert_select "li", I18n.t("oauth.authorizations.new.scopes.write")
    assert_select "button[name=decision][value=allow]"
    assert_select "button[name=decision][value=deny]"
  end

  test "a missing scope means read" do
    sign_in_as users(:mcp_member)
    get new_oauth_authorization_path(authorize_params(challenge: @challenge).except(:scope))

    assert_response :success
    assert_select "input[type=hidden][name=scope][value=?]", "read"
  end

<% end -%>
  test "allow redirects with a code, the state and iss" do
    sign_in_as users(:mcp_member)
    post oauth_authorization_path, params: authorize_params(challenge: @challenge).merge(decision: "allow")

    assert_response :see_other
    assert response.location.start_with?("#{INSPECTOR_REDIRECT_URI}?")
    assert redirect_params["code"].present?
    assert_equal "xyz-state", redirect_params["state"]
    assert_equal "http://www.example.com", redirect_params["iss"]
    assert OauthAuthorizationCode.find_by(code_digest: AccessToken.digest(redirect_params["code"]))
  end

  test "deny redirects with access_denied, the state and iss" do
    sign_in_as users(:mcp_member)
    post oauth_authorization_path, params: authorize_params(challenge: @challenge).merge(decision: "deny")

    assert_client_error "access_denied"
  end

<% unless options[:skip_views] -%>
  test "a redirect_uri the client never registered gets a page, not a redirect" do
    sign_in_as users(:mcp_member)
    get new_oauth_authorization_path(authorize_params(challenge: @challenge, redirect_uri: "https://evil.example.com/callback"))

    assert_response :bad_request
    assert_nil response.location
    assert_select "h1", I18n.t("oauth.authorizations.error.title")
  end

  test "a client that cannot be fetched gets a page, not a redirect" do
    sign_in_as users(:mcp_member)

    # Both are refused before any request leaves the app.
    ["http://inspector.example.com/oauth/client.json", "https://127.0.0.1/client.json"].each do |client_id|
      get new_oauth_authorization_path(authorize_params(challenge: @challenge, client_id: client_id))

      assert_response :bad_request
      assert_nil response.location
    end
    assert_not OauthClient.exists?(client_id: "https://127.0.0.1/client.json")
  end

<% end -%>
  test "refuses a plain PKCE challenge" do
    sign_in_as users(:mcp_member)
    get new_oauth_authorization_path(authorize_params(challenge: @challenge, code_challenge_method: "plain"))

    assert_client_error "invalid_request"
  end

  test "refuses a missing PKCE challenge" do
    sign_in_as users(:mcp_member)
    get new_oauth_authorization_path(authorize_params(challenge: @challenge).except(:code_challenge))

    assert_client_error "invalid_request"
  end

  test "refuses another resource" do
    sign_in_as users(:mcp_member)
    get new_oauth_authorization_path(authorize_params(challenge: @challenge, resource: "http://www.example.com/api"))

    assert_client_error "invalid_target"
  end

  test "refuses an unknown scope" do
    sign_in_as users(:mcp_member)
    get new_oauth_authorization_path(authorize_params(challenge: @challenge, scope: "read admin"))

    assert_client_error "invalid_scope"
  end

  test "refuses a response type other than code" do
    sign_in_as users(:mcp_member)
    get new_oauth_authorization_path(authorize_params(challenge: @challenge, response_type: "token"))

    assert_client_error "unsupported_response_type"
  end

<% if flag_name -%>
  test "with the <%= flag_name %> flag off, the client gets access_denied and no consent screen" do
    sign_in_as users(:mcp_member)

    with_mcp_flag(false) do
      get new_oauth_authorization_path(authorize_params(challenge: @challenge))
    end

    assert_client_error "access_denied"
  end

<% end -%>
  private

  def assert_client_error(error)
    assert_response :see_other
    assert response.location.start_with?("#{INSPECTOR_REDIRECT_URI}?")
    assert_equal error, redirect_params["error"]
    assert_equal "xyz-state", redirect_params["state"]
    assert_equal "http://www.example.com", redirect_params["iss"]
    assert_nil redirect_params["code"]
  end
end
