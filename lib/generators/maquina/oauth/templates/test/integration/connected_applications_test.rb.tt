require "test_helper"
require_relative "../test_helpers/session_test_helper"

# The Connected apps page (generated by maquina:oauth).
class ConnectedApplicationsTest < ActionDispatch::IntegrationTest
<% unless options[:skip_views] -%>
  test "lists the apps connected to the account" do
    sign_in_as users(:mcp_member)
    get connected_apps_path

    assert_response :success
    assert_select "li", /MCP Inspector/
    assert_select "li", /inspector\.example\.com/
  end

  test "says so when nothing is connected" do
    sign_in_as users(:mcp_other)
    get connected_apps_path

    assert_response :success
    assert_select "p", I18n.t("connected_applications.index.empty")
  end

<% end -%>
  test "revoking an app stops its tokens right away" do
    sign_in_as users(:mcp_member)
    delete connected_app_path(oauth_clients(:inspector))

    assert_redirected_to connected_apps_path
    assert_response :see_other
    assert_nil AccessToken.authenticate(MEMBER_READ_ACCESS_TOKEN)
    assert_nil AccessToken.find_by_refresh_token(EXPIRED_REFRESH_TOKEN)
  end

  test "another person's client is not found" do
    sign_in_as users(:mcp_other)
    delete connected_app_path(oauth_clients(:inspector))

    assert_response :not_found
    assert AccessToken.authenticate(MEMBER_READ_ACCESS_TOKEN)
  end

  test "an unknown client is not found" do
    sign_in_as users(:mcp_member)
    delete connected_app_path(id: 0)

    assert_response :not_found
  end

  test "needs a signed-in person" do
    get connected_apps_path

    assert_redirected_to new_session_path
  end
<% if flag_name -%>

  test "with the <%= flag_name %> flag off, the page is not found" do
    sign_in_as users(:mcp_member)

    with_mcp_flag(false) do
      get connected_apps_path
      assert_response :not_found

      delete connected_app_path(oauth_clients(:inspector))
      assert_response :not_found
    end
    assert AccessToken.authenticate(MEMBER_READ_ACCESS_TOKEN)
  end
<% end -%>
end
