# OAuth in tests (generated by maquina:oauth).
#
# The raw values behind the access_tokens and oauth_authorization_codes
# fixtures (the fixtures store only their digests), and PKCE helpers for
# driving /oauth/authorize and /oauth/token:
#
#   verifier, challenge = pkce_pair
#   sign_in_as users(:mcp_member)
#   post oauth_authorization_path, params: authorize_params(challenge: challenge).merge(decision: "allow")
#   code = redirect_params["code"]
module OauthTestHelper
  MCP_RESOURCE = "http://www.example.com/mcp"
  INSPECTOR_REDIRECT_URI = "http://localhost:6274/oauth/callback"

  # oauth_authorization_codes(:mcp_member)
  AUTHORIZATION_CODE = "mcp-member-authorization-code"
  CODE_VERIFIER = "mcp-member-code-verifier-0123456789abcdefghijklmn"

  # access_tokens(:mcp_member_read), (:mcp_member_write), (:mcp_admin_read),
  # (:mcp_member_expired) and (:mcp_member_revoked)
  MEMBER_READ_ACCESS_TOKEN = "mcp-member-read-access-token"
  MEMBER_READ_REFRESH_TOKEN = "mcp-member-read-refresh-token"
  MEMBER_WRITE_ACCESS_TOKEN = "mcp-member-write-access-token"
  MEMBER_WRITE_REFRESH_TOKEN = "mcp-member-write-refresh-token"
  ADMIN_READ_ACCESS_TOKEN = "mcp-admin-read-access-token"
  ADMIN_READ_REFRESH_TOKEN = "mcp-admin-read-refresh-token"
  EXPIRED_ACCESS_TOKEN = "mcp-member-expired-access-token"
  EXPIRED_REFRESH_TOKEN = "mcp-member-expired-refresh-token"
  REVOKED_ACCESS_TOKEN = "mcp-member-revoked-access-token"
  REVOKED_REFRESH_TOKEN = "mcp-member-revoked-refresh-token"

  # [code_verifier, code_challenge] for S256.
  def pkce_pair
    verifier = SecureRandom.urlsafe_base64(48)
    [verifier, pkce_challenge(verifier)]
  end

  def pkce_challenge(verifier)
    Base64.urlsafe_encode64(Digest::SHA256.digest(verifier), padding: false)
  end

  # Every parameter of an authorization request from the inspector fixture.
  def authorize_params(challenge:, **overrides)
    {
      response_type: "code",
      client_id: oauth_clients(:inspector).client_id,
      redirect_uri: INSPECTOR_REDIRECT_URI,
      code_challenge: challenge,
      code_challenge_method: "S256",
      scope: "read",
      state: "xyz-state",
      resource: MCP_RESOURCE
    }.merge(overrides)
  end

  # The query of the last redirect, as a Hash with String keys.
  def redirect_params
    Rack::Utils.parse_query(URI(response.location).query)
  end
<% if flag_name -%>

  # Mcp::FLAG is :<%= flag_name %>, so tests run with it on (ENV wins when
  # credentials say nothing). Turn it off for a block:
  #
  #   with_mcp_flag(false) { get connected_apps_path }
  def with_mcp_flag(enabled)
    previous = ENV["<%= flag_name.upcase %>"]
    ENV["<%= flag_name.upcase %>"] = enabled.to_s
    yield
  ensure
    ENV["<%= flag_name.upcase %>"] = previous
  end
<% end -%>
end
<% if flag_name -%>

ENV["<%= flag_name.upcase %>"] = "true"
<% end -%>

ActiveSupport.on_load(:active_support_test_case) do
  include OauthTestHelper
end
