# The app's MCP server (generated by maquina:oauth): the protocol revision it
# speaks, its version, and the one gate every MCP check goes through.
module Mcp
  PROTOCOL_VERSION = "2026-07-28"
  SERVER_VERSION = "0.1.0"

  # The feature flag that gates MCP, or nil for no gate.
  FLAG = <%= flag_name ? ":#{flag_name}" : "nil" %>

  # Every MCP gate calls this: the OAuth scope, the consent screen, the
  # Connected apps page and the tools a token can see. The app owns this
  # method; swap in Flipper, a column on users or an account plan as needed.
  #
  # With a FLAG, it reads credentials (features: { <flag>: true }) and then
  # the upcased ENV variable.
  def self.enabled_for?(user)
    return true if FLAG.nil?

    ActiveModel::Type::Boolean.new.cast(Rails.application.credentials.dig(:features, FLAG) || ENV[FLAG.to_s.upcase]) == true
  end
end
